From efe5d0f551c1614e1caceddbb32e3e322576e079 Mon Sep 17 00:00:00 2001
From: grepjava <grepjava@gmail.com>
Date: Mon, 12 Oct 2026 12:33:17 +0800
Subject: [PATCH 4/4] Concurrency: Task.yield enqueues without copying the
 current executor

Task.currentExecutor returns an existential, so every yield retained and released the executor object, contended across all threads yielding to it. Enqueue through the executor refs in the same order of preference instead.
---
 stdlib/public/Concurrency/Actor.cpp  | 29 ++++++++++++++++++++++++++++
 stdlib/public/Concurrency/Task.swift |  8 +++++---
 2 files changed, 34 insertions(+), 3 deletions(-)

diff --git a/stdlib/public/Concurrency/Actor.cpp b/stdlib/public/Concurrency/Actor.cpp
index 66f93cf5..d5adc67d 100644
--- a/stdlib/public/Concurrency/Actor.cpp
+++ b/stdlib/public/Concurrency/Actor.cpp
@@ -336,6 +336,35 @@ TaskExecutorRef _swift_getPreferredTaskExecutor() {
   return task->getPreferredTaskExecutor();
 }
 
+#if !SWIFT_CONCURRENCY_EMBEDDED
+extern "C" SWIFT_CC(swift) void _swift_task_enqueueOnTaskExecutor(
+    Job *job, HeapObject *executor, const Metadata *selfType,
+    const TaskExecutorWitnessTable *wtable);
+
+/// Enqueue `job` on the executor `Task.currentExecutor` would return, in the
+/// same order of preference, without materializing it as an existential:
+/// that copy retains and releases the executor object, which every thread
+/// yielding to the same executor contends on.
+extern "C" SWIFT_CC(swift)
+void _swift_task_enqueueOnCurrentExecutor(Job *job) {
+  SerialExecutorRef active = _swift_getActiveExecutor();
+  if (!active.isGeneric())
+    return swift_task_enqueue(job, active);
+
+  TaskExecutorRef taskExecutor = _swift_getPreferredTaskExecutor();
+  if (!taskExecutor.isDefined())
+    taskExecutor = _swift_getCurrentTaskExecutor();
+  if (taskExecutor.isDefined()) {
+    auto identity = taskExecutor.getIdentity();
+    return _swift_task_enqueueOnTaskExecutor(
+        job, identity, swift_getObjectType(identity),
+        taskExecutor.getTaskExecutorWitnessTable());
+  }
+
+  swift_task_enqueueGlobal(job);
+}
+#endif
+
 #pragma clang diagnostic pop
 
 JobPriority swift::swift_task_getCurrentThreadPriority() {
diff --git a/stdlib/public/Concurrency/Task.swift b/stdlib/public/Concurrency/Task.swift
index 3ad1294e..b49b4f07 100644
--- a/stdlib/public/Concurrency/Task.swift
+++ b/stdlib/public/Concurrency/Task.swift
@@ -638,9 +638,7 @@ extension Task where Success == Never, Failure == Never {
 
       #if !$Embedded && !SWIFT_STDLIB_TASK_TO_THREAD_MODEL_CONCURRENCY
       if #available(StdlibDeploymentTarget 6.3, *) {
-        let executor = Task.currentExecutor
-
-        executor.enqueue(ExecutorJob(context: job))
+        _enqueueOnCurrentExecutor(job)
       } else {
         fatalError("we shouldn't get here; if we have, availability is broken")
       }
@@ -807,6 +805,10 @@ func getJobFlags(_ task: Builtin.NativeObject) -> JobFlags
 @usableFromInline
 func _enqueueJobGlobal(_ task: Builtin.Job)
 
+@available(SwiftStdlib 6.3, *)
+@_silgen_name("_swift_task_enqueueOnCurrentExecutor")
+func _enqueueOnCurrentExecutor(_ job: Builtin.Job)
+
 @available(SwiftStdlib 5.9, *)
 func _enqueueJobGlobal(_ task: UnownedJob) {
   _enqueueJobGlobal(task._context)
-- 
